---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Main from "../components/Main.astro";

import { Picture } from "astro:assets";

// fullscale images for <Picture>
import carolineImage from "../assets/images/caroline-temp-lowres-opacity75.png";
import artofdyeingImage from "../assets/images/artofdyeing.png";
import howwilltodayImage from "../assets/images/howwilltoday.png";
import weseeyouImage from "../assets/images/weseeyou.png";

// the intro section image, done as background
const ilikeyouBgImage = "url(/images/ilikeyou-temp-lowres.jpg)";
// import daydreamImage from "../../public/images/daydream-temp-lowres.jpg";
// import { Image } from "astro:assets";
---

<Layout
	title="Day Eight - Design | Social | Creative"
	description="Branding and Graphic Design Studio in Yorkshire. Making ambitious businesses look as good as they are through branding, design, social media and digital."
>
	<!-- wrapper div for the content minus the hero, so we can margin everything past the hero, which will have position: fixed -->
	<div class="content-wrapper">
		<Header />
		<!-- put any css to control min-height and flex-grow of body, main, header and footer in global.css -->

		<Main>
			<!-- not sure there's any benefit to doing this content as components at the moment -->
			<!-- maybe to keep the email obfuscation stuff tidy? -->

			<!-- Header (temp) -->

			<!-- About Us section -->
			<section class="intro flex-columns">
				<div>
					<!-- need another div here to keep the heading and email -->
					<!-- aligned right, but centred within outer container -->
					<div class="section__content">
						<h1 class="section__heading serif-fancy">
							Day Eight is an innovative creative studio specialising in branding, design, social content &amp; creative
							communication.
						</h1>

						<div class="content__button serif-regular content__button--purple">Say hello.</div>
					</div>
				</div>

				<div class="section__image ilikeyou">
					<!-- Doing this as a background, at least for now -->
				</div>
			</section>

			<section class="builtonpassion flex-columns">
				<div>
					<!-- need another div here to keep the heading and email -->
					<!-- aligned right, but centred within outer container -->
					<div class="section__content">
						<h2 class="section__heading serif-fancy">Built on passion.</h2>

						<p>
							We help ambitious businesses build brands that people remember through thoughtful branding, creative
							design, engaging content and meaningful communication. From startups finding their feet to established
							businesses ready for their next chapter, we bring ideas to life with creativity, clarity and purpose.
						</p>

						<p>
							We especially love working with businesses making life better, greener, healthier or simply more
							enjoyable. The kind of brands built by passionate people, bold ideas and a desire to do things
							differently.
						</p>
						<p>Just good people doing good stuff.</p>
					</div>
				</div>

				<div class="section__secondary-content">
					<!-- extra div here just in case -->
					<div>
						<!-- caroline picture -->
						<Picture
							class="secondary-content__img picture-image picture-image--hide caroline-image"
							src={carolineImage}
							formats={["webp", "jpeg"]}
							widths={[240, 540, 720, 960, 1280, 1920]}
							alt="Caroline, founder of Day Eight"
							loading="lazy"
							width="150"
							height="150"
						/>
						<!-- <Image src={carolineImage} alt="" /> -->

						<q class="section__quote serif-fancy">
							Day Eight was built on the belief that the best work comes from caring deeply about what you do.
						</q>

						<p class="section__quote-attr">Caroline - Founder, Day Eight</p>
					</div>
				</div>
			</section>

			<section class="letscreate flex-centred">
				<div class="section__content flex-centred">
					<h2 class="section__heading serif-fancy">Let's create.</h2>

					<p>Day Eight is an independent studio based in the creative hub of Saltaire, West Yorkshire.</p>

					<p>
						From standout graphic design to clever content and social media, we help spirited businesses make an
						impression, grow and connect with the people that matter most.
					</p>

					<div class="content__button serif-regular content__button--green">See our work.</div>
				</div>
			</section>

			<section class="picture-section flex-columns">
				<Picture
					class="secondary-content__img picture-image picture-image--hide"
					src={howwilltodayImage}
					formats={["webp", "jpeg"]}
					widths={[240, 540, 720, 960, 1280, 1920]}
					alt="Hallstone branding"
					loading="lazy"
				/>

				<Picture
					class="secondary-content__img picture-image picture-image--hide"
					src={artofdyeingImage}
					formats={["webp", "jpeg"]}
					widths={[240, 540, 720, 960, 1280, 1920]}
					alt="How will today change tomorrow promotional material"
					loading="lazy"
				/>

				<Picture
					class="secondary-content__img picture-image picture-image--hide"
					src={weseeyouImage}
					formats={["webp", "jpeg"]}
					widths={[240, 540, 720, 960, 1280, 1920]}
					alt="Caroline, founder of Day Eight"
					loading="lazy"
				/>
			</section>
		</Main>
	</div></Layout
>

<style define:vars={{ ilikeyouBgImage }}>
	/* flex-columns stuff is in global.css */

	.intro {
		background-color: hsl(var(--navy));
	}

	@media (min-width: 992px) {
		.intro {
			min-height: 75vh;
		}
	}

	/* probably don't want this padding in global, but it will apply to all the flex-column sections */
	.flex-columns {
		/* padding-block: 2rem; */
	}

	.flex-columns > * {
		display: flex;
		padding-block: 2rem;
	}

	@media (min-width: 992px) {
		:is(.intro, .builtonpassion) > :first-child {
			flex-direction: column;
			justify-content: center;
		}

		.intro > :first-child {
			flex-basis: 200%;
		}
	}

	.builtonpassion {
		background-color: hsl(var(--babyblue));
	}

	/* .letscreate {
		padding-block: 2rem;
	} */

	@media (min-width: 992px) {
		.ilikeyou {
			background-image: var(--ilikeyouBgImage);
			background-position: left top;
			background-repeat: no-repeat;
			background-size: cover;
		}
	}

	.section__content {
		display: flex;
		flex-direction: column;
		justify-content: center;
		/* don't set align rules here */
		gap: 1rem;

		padding-block: 2rem;
		padding-inline: 1.2rem;

		/* border: 1px solid pink; */
	}

	@media (min-width: 992px) {
		.section__content {
			display: flex;
			/* don't set align rules here */
			/* align-items: start; */
			gap: 1.5rem;

			padding-block: 2rem;
			padding-inline-start: 4rem;
			padding-inline-end: 2rem;
		}
	}

	/* specifically for section__content in the .intro section */
	.intro .section__content {
		min-height: 88%;
		justify-content: space-between;
		align-items: start;
	}

	.builtonpassion .section__content {
		align-items: start;
	}

	.letscreate .section__content {
		/* max-width: 100ch; */
		/* text-wrap: balance; */
		/* align-items: center; */
		text-align: center;
		/* two column sections have got padding-block 2rem set with * on their direct children */
		/* but letscreate doesn't have those child columns so probably best to put margin-block on the section content */
		/* rather than creating a ruleset for letscreate */
		margin-block: 2rem;
	}

	.section__secondary-content {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding-block: 2rem;
	}

	.builtonpassion .section__secondary-content {
		color: hsl(var(--white));
	}

	.builtonpassion .section__secondary-content div:first-child {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: center;
	}

	.builtonpassion .section__secondary-content div > * {
		/* border: 1px solid blue; */
	}

	.builtonpassion .section__secondary-content div > * {
		text-align: center;
	}

	.builtonpassion .section__secondary-content div .section__quote {
		font-size: 2.3rem;
		max-width: 20ch;
		/* text-wrap: pretty; */
		line-height: 1.3;
		letter-spacing: -0.5px;
	}

	.builtonpassion .section__secondary-content div .section__quote-attr {
		color: hsl(var(--navy));
		font-size: 1rem;
	}

	/* :is(.intro, .builtonpassion, .letscreate) .content__button {
        
    } */

	/* specifically for the button in the .intro section */
	/* (content__button styles are in global.css) */
	.intro .content__button {
		font-size: 2.5rem;
		min-width: 66%;
		/* border: 1px solid fuchsia; */
	}

	/* specifically for the button in the .letscreate section */
	.letscreate .content__button {
		font-size: 2.5rem;
		min-width: 75%;
		margin-block-start: 1rem;
		/* border: 1px solid fuchsia; */
	}

	.picture-section {
		height: 38rem;
		overflow: hidden;
		gap: 1rem;
		padding-block-end: 1rem;
	}

	.picture-section > * {
		padding: 0;
	}

	.picture-section img {
		object-fit: cover;
	}

	.section__image {
		/* border: 1px solid fuchsia; */
		/* background-color: red; */
	}

	.caroline-image {
		width: 8rem;
		margin-block-end: 1rem;
	}

	.section__heading {
		font-size: 2.75rem;
		font-weight: lighter;
		line-height: 1.2;
		/* color: hsl(var(--white)); */
		max-width: 25ch;
		text-wrap: balance;

		/* margin-block-start: 3rem; */
		margin-block-end: 1.5rem;

		/* border: 1px solid yellow; */
	}

	/* section specific headings */
	.intro .section__heading {
		color: hsl(var(--white));
	}

	.builtonpassion .section__heading {
		color: hsl(var(--navy));
		/* font-size: 2.75rem; */
	}

	.letscreate .section__heading {
		color: hsl(var(--navy));
	}

	@media (min-width: 992px) {
		.section__heading {
			font-size: 3rem;
			/* font-weight: 100; */
			/* line-height: 1.2; */
			/* color: hsl(var(--accent)); */
			/* max-width: 25ch; */
			/* text-wrap: balance; */

			/* margin-block-start: 3rem; */
			margin-block-end: 1.5rem;
		}
	}

	.section__content p {
		color: hsl(var(--greynavy));
		/* color: #000; */
		/* font-weight: lighter; */
		font-size: 1.1rem;
		/* line-height: 1.4; */
		max-width: 50ch;
		/* text-wrap: balance; */
		line-height: 1.4;

		/* separate font-family for this so we can use lighter? */
		/* will need checking on other systems though */
	}

	/* section specific p styles */
	.builtonpassion .section__content p {
		color: hsl(var(--white));
	}

	.letscreate .section__content p {
		color: hsl(var(--navy));
	}

	@media (min-width: 992px) {
		.section__content p {
		}
	}

	.section__content p a {
		text-decoration: none;
		color: hsl(var(--accent4));
		/* color: hsl(var(--babyblue)); */
		/* line-height: 2; */
	}

	.section__content p a:is(:hover, :focus-visible) {
		text-decoration: underline;
		text-underline-offset: 0.33rem;
		/* color: hsl(var(--accent)); */
		/* color: hsl(var(--babyblue)); */
	}
</style>
