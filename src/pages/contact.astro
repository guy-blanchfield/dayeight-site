---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Main from "../components/Main.astro";

import daydreamImage from "../assets/images/daydream-temp-lowres.jpg";

// bg image paths have to be passed into <style> as variables
const daydreamBgImage = "url(/images/day-eight-daydream-960.jpg)";
const mapBgImage = "url(/images/day-eight-yorkshire-map.svg)";
// const daydreamBgImage = 'url(/images/daydream-temp-lowres.jpg)';

import obfuscateEmail from "../js/obfuscateEmail";
// don't know much about the second parameter of obfuscateEmail
// other than it's used to generate a hex key, and in the example it's a 3 digit number
const emailObf = obfuscateEmail("hello@dayeightagency.co.uk", 156);
---

<Layout
	title="Day Eight - Design | Social | Creative"
	description="Day Eight is a creative communication agency helping people with branding, social media and PR."
>
	<!-- <Header bgColour="hsl(var(--babyblue))" linkColour="hsl(var(--navy))" /> -->
	<!-- defaults will do bc bg is navy -->
	<Header />

	<Main>
		<!-- intro section is now functioning as a hero (fixed position with sticky header scrolling over it) -->
		<section class="intro flex-columns fixed-hero-section">
			<div>
				<!-- need another div here to keep the heading and email -->
				<!-- aligned right, but centred within outer container -->
				<div class="contactpage__content">
					<h2 class="contactpage__heading serif-fancy">Helping ambitious businesses become impossible to ignore.</h2>

					<p>Every great project starts with a conversation.</p>
					<p>
						Whether you've got a new business, a bold idea or a brand that's ready for its next chapter, we'd love to
						hear about it.
					</p>

					<p>
						Based in Yorkshire and working with good businesses wherever they are in the world, Day Eight helps
						ambitious brands stand out through branding, design, social, content and creative communication.
					</p>

					<p>Pop us a message. Say hello. Let's see where it takes us.</p>
				</div>
			</div>

			<div class="daydream">
				<!-- widths is the image widths we want astro to generate automatically,
					 those values will also be added to the img element srcset e.g. 480w, 640w etc -->
				<!-- sizes is what will be added to the picture or img element as attribute to tell the broswer
					 which image to use depending on media display size -->
				<!-- <Picture class="contact__img picture-image picture-image--hide" src={daydreamImage} formats={['webp', 'jpeg']} widths={[240, 540, 720, 960, 1280, 1920]} alt="Sign saying 'Don't give up the daydream" width="851" height="1146" loading="lazy" /> -->

				<!-- <img src="/images/daydream-temp-lowres.jpg" width="425" height="573" alt=""> -->
				<!-- <img src="/images/daydream-temp-lowres.jpg" alt=""> -->

				<!-- Doing this as a background, at least for now -->
			</div>
		</section>

		<!-- wrapper div for the content minus the hero / intro section, so we can margin everything past the hero, which will have position: fixed -->
		<div class="content-wrapper">
			<section class="contactpage__contactsection">
				<div class="contactsection__content">
					<!-- contact section email and contact form -->
					<!-- just the mailto for the time being -->

					<!-- <div id="email" class="contactpage__email serif">e. <a href={`mailto:${emailObf}`} class="eml-protected contactpage__mailto hidden">{emailObf}</a></div> -->
					<!-- <div id="email" class="contactpage__email serif-fancy">
					e. <a href={`${emailObf}`} class="eml-protected contactpage__mailto hidden">{emailObf}</a>
				</div> -->

					<h2 class="contactsection__heading serif-regular">Say hello.</h2>

					<form action="" class="contactsection__form" id="contact-form">
						<!-- group the inputs is their own div -->
						<div class="form__inputs">
							<div class="input-and-label">
								<label for="contact-name"
									>Name <span class="visually-hidden" id="contact-name-error-hidden"></span>
								</label>
								<input type="text" name="contact-name" id="contact-name" />
							</div>
							<div class="input-and-label">
								<label for="contact-email"
									>Email <span class="label-required">(required)</span>
									<span class="visually-hidden" id="contact-email-error-hidden"></span>
								</label>
								<input type="text" name="contact-email" id="contact-email" />
							</div>
						</div>

						<div class="textarea-and-label">
							<label for="contact-message"
								>Message <span class="label-required">(required)</span>
								<span class="visually-hidden" id="contact-message-error-hidden"></span>
							</label>
							<textarea name="contact-message" id="contact-message"></textarea>
						</div>

						<!-- ============== recaptcha ============== -->
						<!-- let's have a container for the recaptcha, keep things tidy -->
						<div class="contactsection__recaptcha">
							<!-- recaptcha explicit rendering -->
							<div id="contact-recaptcha" class="g-recaptcha"></div>
							<span class="visually-hidden" id="contact-recaptcha-error-hidden"></span>
							<div class="contact-error" id="contact-recaptcha-error" aria-hidden="true">
								<span class="contact-error-content"><!-- empty to start --></span>
							</div>
						</div>

						<!-- button type submit here NOT input type submit so we can add the waiting animation inside it i think? -->
						<button
							type="submit"
							class="contact-submit content__button content__button--pink serif-regular"
							name="contact-submit"
							id="contact-submit">Send.</button
						>
					</form>

					<!-- just do one error-message area, there isn't really any room for dedicated error messages for each input -->
					<!-- we'll probably need to create each message dynamically so they can all be visible at the same time -->
					<!-- rather than it only displaying one error message at a time -->

					<!-- maybe just stick them all here for the time being while we're testing it -->
					<div class="contact-error" id="contact-name-error" aria-hidden="true">
						<span class="contact-error-content"><!-- empty to start --></span>
					</div>

					<div class="contact-error" id="contact-email-error" aria-hidden="true">
						<span class="contact-error-content"><!-- empty to start --></span>
					</div>

					<div class="contact-error" id="contact-message-error" aria-hidden="true">
						<span class="contact-error-content"><!-- empty to start --></span>
					</div>

					<div class="contact-error" id="contact-recaptcha-error" aria-hidden="true">
						<span class="contact-error-content"><!-- empty to start --></span>
					</div>

					<!-- success message -->
					<div id="contact-success" class="contact-success" data-visible="false" aria-hidden="true">
						Thank you for your message
					</div>
				</div>
			</section>
		</div>
	</Main>
</Layout>

<script src="/src/js/contact.js"></script>

<script src="/src/js/decodeEmail.js"></script>

<!-- probably need this recaptcha stuff is:inline -->

<!-- safest to put recaptcha inline, external was unreliable -->
<!-- first get the key from the gitignored js file -->
<script src="/src/js/grc-key.js" is:inline></script>
<script is:inline>
	// recaptcha - explicit rendering - onload callback
	// NB has to be var! and also anonymous function

	// env variables are now a massive hassle in astro so let's just use a js file and gitignore it
	// if you really want to do the .env thing see https://youtu.be/kTceOl4qCm0
	// but it looks pretty complicated and unnecessary for our purposes

	// could we use php to insert the key somehow?

	console.log("grcKey:", grcKey);

	var onloadCallback = function () {
		grecaptcha.render("contact-recaptcha", {
			// real key

			sitekey: grcKey,
			callback: "verifyRecaptcha",
			"expired-callback": "recaptchaExpired",
		});
	};
</script>

<script is:inline src="https://www.google.com/recaptcha/api.js?onload=onloadCallback&render=explicit" async defer
></script>

<style define:vars={{ daydreamBgImage, mapBgImage }}>
	.intro {
		background-color: hsl(var(--white));
		/* display: flex; */
		/* flex-direction: column; */
	}

	@media (min-width: 992px) {
		.intro {
			flex-direction: row;
			justify-content: space-between;

			/* min-height: 75vh; */
			/* min-height: calc(100vh - var(--header-height));
			position: fixed;
			top: 0;

			/* because position fixed essentially takes the element out of its context, it won't naturally fill the space */
			/* so we have to tell it to take up the full width - is there a better way to do this? */
			/* width: 100vw; */
		}
	}

	.intro > * {
		display: flex;
	}

	@media (min-width: 992px) {
		.intro > * {
			/* shorthand */
			flex: 100%;

			/* flex-grow: 1;
			flex-shrink: 1;
			flex-basis: 100%; */
		}
		.intro > :first-child {
			flex-basis: 200%;
		}
	}

	@media (min-width: 992px) {
		.daydream {
			background-image: var(--daydreamBgImage);
			background-position: left top;
			background-repeat: no-repeat;
			background-size: cover;
		}
	}

	@media (min-width: 992px) {
		.contactpage__contactsection {
			/* add a min-height so the section is tall enough to get the sticky header to the top when it scrolls */
			/* at some point this might be redundant if we put more content in the contact page */
			/* bit of a magic number here, we can probably improve it if we a footer height var */
			min-height: 90vh;
		}
	}

	.contactpage__content {
		display: flex;
		flex-direction: column;
		justify-content: center;
		/* padding: 3rem 3rem; */
		gap: 1rem;

		padding-block: 2rem;
		padding-inline: 1.2rem;

		/* border: 1px solid pink; */
	}

	@media (min-width: 992px) {
		.contactpage__content {
			display: flex;
			flex-direction: column;
			justify-content: center;
			/* padding: 3rem 3rem; */
			gap: 1.5rem;

			padding-block: 2rem;
			padding-inline-start: 4rem;
			padding-inline-end: 4rem;

			/* border: 1px solid pink; */
		}
	}

	.contactpage__heading {
		font-size: 2rem;
		font-weight: 100;
		line-height: 1.2;
		color: hsl(var(--accent));
		max-width: 40ch;
		text-wrap: balance;

		/* margin-block-start: 3rem; */
		margin-block-end: 1.5rem;
	}

	@media (min-width: 992px) {
		.contactpage__heading {
			font-size: 3rem;
			/* font-weight: 100; */
			/* line-height: 1.2; */
			/* color: hsl(var(--accent)); */
			max-width: 20ch;
			/* text-wrap: balance; */

			/* margin-block-start: 3rem; */
			margin-block-end: 1.5rem;
		}
	}

	.contactpage__content p {
		color: hsl(var(--greynavy));
		/* color: #000; */
		/* font-weight: lighter; */
		/* font-size: 1.1rem; */
		/* line-height: 1.4; */
		max-width: 50ch;
		text-wrap: pretty;
		line-height: 1.4;

		/* separate font-family for this so we can use lighter? */
		/* will need checking on other systems though */
	}

	@media (min-width: 992px) {
		.contactpage__content p {
		}
	}

	.contactpage__content p a {
		text-decoration: none;
		color: hsl(var(--accent4));
		/* color: hsl(var(--babyblue)); */
		/* line-height: 2; */
	}

	.contactpage__content p a:is(:hover, :focus-visible) {
		text-decoration: underline;
		text-underline-offset: 0.33rem;
		/* color: hsl(var(--accent)); */
		/* color: hsl(var(--babyblue)); */
	}

	.contactpage__contactsection {
		background-color: hsl(var(--background-dark));
		color: hsl(var(--white));
		display: flex;
		align-items: center;

		/* padding has to be on the section not the content div because of the map bg on the content div */
		padding-block: 2rem;
		padding-inline-start: 1.3rem;
		padding-inline-end: 1rem;

		/* border: 3px solid cyan; */
	}

	/* contact section content */
	.contactsection__content {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		justify-content: center;
		/* align-items: start; */

		/* min-height: 30rem; */
		width: min(67rem, 100%);
		/* border: 1px solid fuchsia; */
	}

	.contactsection__heading {
		color: hsl(var(--white));
		font-size: 2.5rem;
		letter-spacing: -1px;
	}

	@media (min-width: 992px) {
		.contactpage__contactsection {
			/* padding has to be on the section not the content div */
			/* because the map image is a background on the content div so the padding doesn't apply */
			padding-block-start: 2rem;
			padding-block-end: 6rem;
			padding-inline-start: 4rem;
			padding-inline-end: 2rem;
		}
		.contactsection__content {
			background-image: var(--mapBgImage);
			background-repeat: no-repeat;
			background-size: 14rem;
			background-position: top 0rem right 0rem;
		}
	}

	/* email is the div */
	.contactpage__email {
		font-size: 1.3rem;
		color: hsl(var(--babyblue));
	}
	/* mailto is the link */
	.contactpage__mailto {
		color: hsl(var(--white));
		text-decoration: none;
	}
	.contactpage__mailto:is(:hover, :focus-visible) {
		/* color: hsl(var(--orchid)); */
		text-decoration: underline;
		text-underline-offset: 0.5rem;
	}

	@media (min-width: 992px) {
		/* email is the div */
		.contactpage__email {
			font-size: 2rem;
		}
		/* mailto is the link */
		.contactpage__mailto {
		}
		.contactpage__mailto:is(:hover, :focus-visible) {
			/* color: hsl(var(--orchid)); */
			/* text-decoration: underline; */
			text-underline-offset: 1rem;
		}
	}

	/* contact form stuff */

	.contactsection__form {
		display: flex;
		flex-direction: column;
		flex-wrap: wrap;
		width: min(50rem, 100%);
		/* border: 1px solid green; */
	}

	@media (min-width: 992px) {
		.contactsection__form {
			/* flex-direction: row; */
		}
	}

	.contactsection__form :is(input, textarea) {
		border: none;
		margin: 0;
		padding: 0;
	}

	.contactsection__form :is(input, textarea):focus-visible {
		/* border: 1px solid hsl(var(--lightgrey)); */
		outline: none;
		/* background-color: hsl(var(--lightgrey)); */
		background-color: #eee;
		margin: 0;
		padding: 0;
	}

	.contactsection__form input:not(textarea) {
		/* border: 1px solid red; */
		/* border: none; */
	}

	.contactsection__form .input-and-label {
		display: flex;
		flex-direction: column;
		background-color: hsl(var(--white));
		/* border: 1px solid blue; */
		padding-block: 0.2rem;
		padding-inline: 0.5rem;
	}

	@media (min-width: 992px) {
		.contactsection__form .input-and-label {
			width: 50%;
		}
	}

	.contactsection__form textarea {
		background-color: hsl(var(--white));
		/* border: 1px solid yellow; */
		/* border: none; */
		/* padding-block: 0.2rem; */
		/* padding-inline: 0.5rem; */
		/* margin: 0; */
		min-height: 8rem;
		resize: none;
	}

	.contactsection__form .textarea-and-label {
		display: flex;
		flex-direction: column;
		background-color: hsl(var(--white));
		/* border: 1px solid green; */
		padding: 0.5rem;
	}

	.contactsection__form label {
		/* color: hsl(var(--navy)); */
		/* color: hsl(var(--lightgrey)); */
		/* opacity: 66%; */
		color: hsl(var(--lightgreynavy));
		/* font-size: small; */
	}

	.contactsection__form label span.label-required {
		font-size: smaller;
		color: hsl(var(--pink));
	}

	.form__inputs {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-block-end: 0.6rem;
	}

	@media (min-width: 992px) {
		.form__inputs {
			flex-direction: row;
			gap: 0.6rem;
		}
	}

	.contactsection__form button {
		font-size: 2rem;
		width: 50%;
		margin-block-start: 2rem;
	}

	/* gonna put disabled class here, put it in global if we end up using elsewhere */
	.contactsection__form button.disabled {
		background-color: #ccc;
	}

	.contactsection__recaptcha {
		margin-block-start: 2rem;
	}

	/* success message */
	.contact-success {
		display: flex;
		justify-content: center;
		align-items: center;

		/* transform: translateY(-100%); */
		visibility: hidden;
		opacity: 0;
	}

	.contact-success[data-visible="true"] {
		visibility: visible;
		opacity: 1;
	}

	/* error message stuff */

	.contact-error-content {
		/* opacity for now */
		opacity: 0;
	}

	.contact-error-content.show {
		opacity: 1;
	}

	.contact-error-content {
		transition: all ease-in-out 250ms;
	}

	/* loading animation for the submit button while form is fetch()ing - might put this in global as well, if we use it elsewhere */

	.loading {
		display: flex;
		justify-content: center;
	}

	.loading--full-height {
		align-items: center;
		height: 100%;
	}

	.loading::after {
		content: "";
		width: 2rem;
		height: 2rem;
		border: 0.2rem solid transparent;
		border-top-color: hsl(var(--white));
		border-right-color: hsl(var(--white));
		border-radius: 50%;
		animation: loading 0.75s linear infinite;
	}

	@keyframes loading {
		to {
			transform: rotate(1turn);
		}
	}
</style>
